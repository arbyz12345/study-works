import tkinter as tk
from tkinter import messagebox

def add(a, b): return a + b
def sub(a, b): return a - b
def mul(a, b): return a * b
def div(a, b):
    if b == 0:
        raise ZeroDivisionError("Деление на ноль")
    return a / b
def pow_(a, b): return a ** b
def sqrt_(a):
    if a < 0:
        raise ValueError("Корень из отрицательного числа")
    return a ** 0.5
def fact(n):
    n_int = int(n)
    if n < 0 or n != n_int:
        raise ValueError("Факториал определён для целых неотрицательных чисел")
    res = 1
    for i in range(2, n_int + 1):
        res *= i
    return res

class Memory:
    def __init__(self):
        self._m = 0.0

    def save(self, x):
        self._m = float(x)

    def read(self):
        return self._m

    def add_to_mem(self, x):
        self._m += float(x)

    def clear(self):
        self._m = 0.0


class CalculatorApp(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title('Калькулятор')
        self.geometry('340x460')
        self.resizable(False, False)
        self.mem = Memory()
        self.expr_var = tk.StringVar(value='0')
        self._build_ui()

    def _build_ui(self):
        entry = tk.Entry(
            self,
            textvariable=self.expr_var,
            font=('Arial', 18),
            justify='right',
            bd=2,
            relief='sunken'
        )
        entry.grid(row=0, column=0, columnspan=5, sticky='we', padx=5, pady=5)

        
        btns = [
            ('7', 1, 0), ('8', 1, 1), ('9', 1, 2), ('/', 1, 3), ('C', 1, 4),
            ('4', 2, 0), ('5', 2, 1), ('6', 2, 2), ('*', 2, 3), ('M+', 2, 4),
            ('1', 3, 0), ('2', 3, 1), ('3', 3, 2), ('-', 3, 3), ('M-', 3, 4),
            ('0', 4, 0), ('.', 4, 1), ('=', 4, 2), ('+', 4, 3), ('MR', 4, 4),
            ('^', 5, 0), ('√', 5, 1), ('!', 5, 2), ('MC', 5, 3), ('', 5, 4),
        ]

        for txt, r, c in btns:
            if not txt:
                continue
            cmd = lambda t=txt: self._on_btn(t)
            b = tk.Button(self, text=txt, width=5, height=2, command=cmd)
            b.grid(row=r, column=c, padx=2, pady=2)

        

    def _on_btn(self, label):
        cur = self.expr_var.get().strip()

        if label == 'C':
            self.expr_var.set('0')
            return

        # Память: M+, M-, MR, MC
        if label == 'M+':
            try:
                val = float(cur or 0)
                self.mem.add_to_mem(val)
            except ValueError:
                messagebox.showerror('Ошибка', 'Некорректное число для сохранения в память')
            return
        if label == 'M-':
            try:
                val = float(cur or 0)
                self.mem.add_to_mem(-val)
            except ValueError:
                messagebox.showerror('Ошибка', 'Некорректное число для вычитания из памяти')
            return
        if label == 'MR':
            self.expr_var.set(str(self.mem.read()))
            return
        if label == 'MC':
            self.mem.clear()
            return

        if label == '=':
            expr = cur.replace('^', '**')
            
            allowed = {
                '__builtins__': None,
                'add': add, 'sub': sub, 'mul': mul, 'div': div,
                'pow_': pow_, 'sqrt_': sqrt_, 'fact': fact,
            }
            try:
               
                self._calculate_expression(expr)
            except Exception as e:
                messagebox.showerror('Ошибка', str(e))
                self.expr_var.set('0')
            return

        
        if label == '√':
            try:
                val = sqrt_(float(cur))
                self.expr_var.set(str(val))
            except ValueError as e:
                messagebox.showerror('Ошибка', str(e))
                self.expr_var.set('0')
            return

        if label == '!':
            try:
                val = fact(float(cur))
                self.expr_var.set(str(val))
            except ValueError as e:
                messagebox.showerror('Ошибка', str(e))
                self.expr_var.set('0')
            return

        
        if cur == '0' and label.isdigit():
            self.expr_var.set(label)
        else:
            self.expr_var.set(cur + label)

    def _calculate_expression(self, expr):
        

        import re
        tokens = re.findall(r'\d+\.?\d*|[+\-*/^]', expr)
        if not tokens:
            raise ValueError("Пустое выражение")

        i = len(tokens) - 1
        while i > 0:
            if tokens[i] == '^':
                a = float(tokens[i-1])
                b = float(tokens[i+1])
                res = pow_(a, b)
                tokens[i-1:i+2] = [str(res)]
                i = len(tokens) - 1  # перезапускаем поиск
                continue
            i -= 1

        # Затем умножение и деление
        i = 0
        while i < len(tokens):
            if tokens[i] in ('*', '/'):
                a = float(tokens[i-1])
                op = tokens[i]
                b = float(tokens[i+1])
                if op == '*':
                    res = mul(a, b)
                else:
                    res = div(a, b)
                tokens[i-1:i+2] = [str(res)]
                i = 0  # перезапуск
                continue
            i += 1

        # Наконец сложение и вычитание
        i = 0
        while i < len(tokens):
            if tokens[i] in ('+', '-'):
                a = float(tokens[i-1])
                op = tokens[i]
                b = float(tokens[i+1])
                if op == '+':
                    res = add(a, b)
                else:
                    res = sub(a, b)
                tokens[i-1:i+2] = [str(res)]
                i = 0
                continue
            i += 1

        result = float(tokens[0])
        self.expr_var.set(str(result))


if __name__ == '__main__':
    app = CalculatorApp()
    app.mainloop()
